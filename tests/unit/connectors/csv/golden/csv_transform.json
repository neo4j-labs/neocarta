  "query_nodes": [
    {
      "content": "SELECT c.customer_name, SUM(o.total_amount) as total_spend FROM demo_ecommerce.customers c JOIN demo_ecommerce.orders o ON c.customer_id = o.customer_id GROUP BY c.customer_name ORDER BY total_spend DESC",
      "description": "Calculate total spend per customer",
      "id": "q001",
      "name": null
    },
    {
      "content": "SELECT p.category, COUNT(DISTINCT oi.order_id) as order_count FROM demo_ecommerce.products p JOIN demo_ecommerce.order_items oi ON p.product_id = oi.product_id GROUP BY p.category",
      "description": "Count orders by product category",
      "id": "q002",
      "name": null
    },
    {
      "content": "SELECT DATE(o.order_date) as date, SUM(o.total_amount) as daily_revenue FROM demo_ecommerce.orders o GROUP BY DATE(o.order_date) ORDER BY date",
      "description": "Calculate daily revenue",
      "id": "q003",
      "name": null
    },
    {
      "content": "SELECT p.product_name, SUM(oi.quantity) as total_quantity FROM demo_ecommerce.products p JOIN demo_ecommerce.order_items oi ON p.product_id = oi.product_id GROUP BY p.product_name ORDER BY total_quantity DESC LIMIT 10",
      "description": "Top 10 best selling products by quantity",
      "id": "q004",
      "name": null
    }
  ],
