# Config for submit_finance_genie.py — copy to submit_finance_genie.env and fill
# in the infra placeholders. The populated submit_finance_genie.env is local-only;
# do not commit it.
#
# This file is self-contained on purpose: it carries both the Databricks infra
# values (normally a dbxcarta base .env) and the finance-genie ingest contract,
# so the example runs from the neocarta repo with no dbxcarta checkout. It is
# secret-free: the Neo4j credentials are NOT here. On-cluster the ingest job
# reads them from the Databricks secret scope named below
# (NEOCARTA_DATABRICKS_SECRET_SCOPE), which must already be provisioned.
#
# dbxcarta-submit reads this file because submit_finance_genie.py points
# DBXCARTA_ENV_FILE at it. The submit tool forwards these KEY=VALUE pairs to the
# cluster as job parameters, so keep it secret-free.

# --- Databricks infra (fill these in for your workspace) ---
# Auth: a profile from ~/.databrickscfg. Omit to use the SDK auth chain.
DATABRICKS_PROFILE=<databricks-profile>
# Where uploaded job scripts are stored.
DATABRICKS_WORKSPACE_DIR=/Users/<user>@<domain>/dbxcarta
# Ingest runs the Neo4j Spark Connector (a JVM library), so it needs a classic
# (non-serverless) cluster with that connector attached.
DATABRICKS_COMPUTE_MODE=cluster
DATABRICKS_CLUSTER_ID=<cluster-id>
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# UC Volume root for staging the connector wheel and the bootstrap script.
DATABRICKS_VOLUME_PATH=/Volumes/dbxcarta-catalog/finance_genie_ops/dbxcarta-ops

# --- neocarta ingest contract (NEOCARTA_DATABRICKS_*) ---
# The connector wheel reads only these on the cluster. Pre-filled with the
# finance-genie values; adjust for your deployment.
NEOCARTA_DATABRICKS_SECRET_SCOPE=dbxcarta-neo4j-finance-genie
NEOCARTA_DATABRICKS_CATALOG=graph-enriched-finance-silver
NEOCARTA_DATABRICKS_CATALOGS=graph-enriched-finance-silver:silver,graph-enriched-finance-gold:gold
NEOCARTA_DATABRICKS_SCHEMAS=graph-enriched-schema
# Value sampling.
NEOCARTA_DATABRICKS_INCLUDE_VALUES=true
NEOCARTA_DATABRICKS_SAMPLE_LIMIT=10
NEOCARTA_DATABRICKS_SAMPLE_CARDINALITY_THRESHOLD=50
# Inline embeddings: embed nodes in-cluster during ingest.
NEOCARTA_DATABRICKS_INCLUDE_EMBEDDINGS_TABLES=true
NEOCARTA_DATABRICKS_INCLUDE_EMBEDDINGS_COLUMNS=true
NEOCARTA_DATABRICKS_INCLUDE_EMBEDDINGS_SCHEMAS=true
NEOCARTA_DATABRICKS_INCLUDE_EMBEDDINGS_DATABASES=true
# OpenAI-backed External Model endpoint; openai-text-embedding-3-small emits
# 1536-dim vectors. Create it per the connector README ("Registering the OpenAI
# endpoint (manual step)"); the OpenAI key lives in a Databricks secret it reads.
NEOCARTA_DATABRICKS_EMBEDDING_ENDPOINT=openai-text-embedding-3-small
NEOCARTA_DATABRICKS_EMBEDDING_DIMENSION=1536
NEOCARTA_DATABRICKS_EMBEDDING_BATCH_TABLES=200
NEOCARTA_DATABRICKS_EMBEDDING_FAILURE_MAX=0
# Required transient staging subpath for each batch's ai_query materialization.
NEOCARTA_DATABRICKS_EMBEDDING_STAGING_VOLUME=/Volumes/dbxcarta-catalog/finance_genie_ops/dbxcarta-ops/dbxcarta/embed-staging
# Optional durable run-summary Volume so a detached cluster run leaves a report.
NEOCARTA_DATABRICKS_SUMMARY_VOLUME=/Volumes/dbxcarta-catalog/finance_genie_ops/dbxcarta-ops/dbxcarta/runs
