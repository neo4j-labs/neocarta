# Local-demo .env for the Finance Genie example.
#
# Copy this file to `.env` in this same directory before running the local
# demo. The demo loads `.env` anchored to this directory and never inherits
# the parent dbxcarta repo's .env, so this file is the single source of
# truth for the local demo.
#
# The dbxcarta CLI (--check-ready, --upload-questions, submit-entrypoint)
# is a separate workflow run from the parent dbxcarta repo and uses that
# repo's .env, not this one. Its per-integration config is the committed,
# secret-free ./dbxcarta-overlay.env; edit that file, not this one, to change
# a CLI run. The two intentionally differ (this file targets the standalone
# local-demo catalog; the overlay targets the medallion catalogs).

# --- Operator credentials (fill these in) ---------------------------------

DATABRICKS_PROFILE=aws-partner-rk
DATABRICKS_WAREHOUSE_ID=
DBXCARTA_CHAT_ENDPOINT=databricks-claude-sonnet-4-6

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# OpenAI API key for the external-models embedding endpoint. Required only when
# the overlay sets OPENAI_SECRET_SCOPE; ./setup_secrets.sh provisions it into
# that shared Databricks scope. Leave blank to skip OpenAI provisioning.
OPENAI_API_KEY=

# --- dbxcarta overlay for the Finance Genie Lakehouse ---------------------

DBXCARTA_CATALOG=graph-enriched-lakehouse
DBXCARTA_SCHEMAS=graph-enriched-schema
DATABRICKS_VOLUME_PATH=/Volumes/graph-enriched-lakehouse/graph-enriched-schema/graph-enriched-volume

DBXCARTA_SUMMARY_VOLUME=/Volumes/graph-enriched-lakehouse/graph-enriched-schema/graph-enriched-volume/dbxcarta/runs
DBXCARTA_SUMMARY_TABLE=graph-enriched-lakehouse.graph-enriched-schema.dbxcarta_run_summary

DBXCARTA_INCLUDE_VALUES=true
DBXCARTA_SAMPLE_LIMIT=10
DBXCARTA_SAMPLE_CARDINALITY_THRESHOLD=50

DBXCARTA_INCLUDE_EMBEDDINGS_TABLES=true
DBXCARTA_INCLUDE_EMBEDDINGS_COLUMNS=true
DBXCARTA_INCLUDE_EMBEDDINGS_VALUES=true
DBXCARTA_INCLUDE_EMBEDDINGS_SCHEMAS=true
DBXCARTA_INCLUDE_EMBEDDINGS_DATABASES=true

# Matches the neocarta MCP cutover: OpenAI text-embedding-3-small via the
# external-models endpoint, mirroring ./dbxcarta-overlay.env. This keeps the
# local demo embedding queries with the same model the graph was ingested with.
DBXCARTA_EMBEDDING_ENDPOINT=openai-text-embedding-3-small
DBXCARTA_EMBEDDING_DIMENSION=1536
DBXCARTA_EMBEDDING_FAILURE_MAX=0

DBXCARTA_CLIENT_QUESTIONS=/Volumes/graph-enriched-lakehouse/graph-enriched-schema/graph-enriched-volume/dbxcarta/questions.json
DBXCARTA_CLIENT_ARMS=no_context,schema_dump,graph_rag
DBXCARTA_INJECT_CRITERIA=false
