NEO4J_USERNAME=neo4j-username
NEO4J_PASSWORD=neo4j-password
NEO4J_URI=neo4j-uri
NEO4J_DATABASE=neo4j-database

GCP_PROJECT_ID=project-id
GCP_PROJECT_NUMBER=project-number

BIGQUERY_DATASET_ID=demo_ecommerce
BIGQUERY_LOCATION=us

DATAPLEX_LOCATION=us
DATAPLEX_GLOSSARY_ID=glossary-id

# Text2SQL agent chat LLM — LiteLLM model id. Examples:
#   gpt-4o-mini
#   gemini-2.0-flash
AGENT_MODEL=gpt-4o-mini

# Embeddings — LiteLLM model id.
# Examples:
#   text-embedding-3-small                       (OpenAI)
#   gemini-embedding-001                         (Vertex AI)
EMBEDDING_MODEL=text-embedding-3-small

# Provider credentials — set the variables your chosen EMBEDDING_MODEL requires.
OPENAI_API_KEY=...
# GEMINI_API_KEY=...

# --- Databricks connector: external embedding (`neocarta databricks embed`) ---
# The CLI embeds an already-ingested Databricks graph and writes vectors back.
# It reads this .env from the current working directory and uses NEO4J_* and
# OPENAI_API_KEY above, plus the two settings below.
#
# EMBEDDING_DIMENSIONS MUST equal the dimension the Spark ingest built the vector
# indexes with (NEOCARTA_DATABRICKS_EMBEDDING_DIMENSION on the job). Mismatched
# vectors are silently left out of the index and vector search returns nothing.
# The CLI default is 768; the OpenAI endpoint emits 1536. Set 1536 to match.
EMBEDDING_DIMENSIONS=1536
