NEO4J_USERNAME=neo4j-username
NEO4J_PASSWORD=neo4j-password
NEO4J_URI=neo4j-uri
NEO4J_DATABASE=neo4j-database

GCP_PROJECT_ID=project-id
GCP_PROJECT_NUMBER=project-number

BIGQUERY_DATASET_ID=demo_ecommerce
BIGQUERY_LOCATION=us

DATAPLEX_LOCATION=us
DATAPLEX_GLOSSARY_ID=glossary-id

# JDBC connector (via SchemaCrawler). Requires Java 11+, the SchemaCrawler
# distribution (point SCHEMACRAWLER_JAR at its _schemacrawler/lib/* classpath,
# which must include a FreeMarker JAR), and a JDBC driver JAR. See
# neocarta/connectors/jdbc/README.md.
JDBC_URL=jdbc:postgresql://localhost:5432/mydb
JDBC_DRIVER=org.postgresql.Driver
JDBC_DRIVER_JAR=lib/postgresql-42.7.3.jar
SCHEMACRAWLER_JAR=schemacrawler-16.x.x-distribution/_schemacrawler/lib/*
JDBC_USER=db-user
JDBC_PASSWORD=db-password
# Optional. Set when the database name can't be parsed from JDBC_URL (e.g. Oracle
# SID / SQL Server URLs).
# JDBC_SOURCE_DATABASE_NAME=mydb
# Optional graph Database-node hints; JDBC_SERVICE defaults to the product
# SchemaCrawler reports.
# JDBC_PLATFORM=AWS_RDS
# JDBC_SERVICE=POSTGRESQL
# Optional. Max seconds for the SchemaCrawler subprocess (default: 120).
# JDBC_TIMEOUT=120

# Unity Catalog connector (open UC REST API). Works against any conformant
# Unity Catalog server. UC_SERVER_URL must include the API version prefix; a
# local OSS server needs no token. See neocarta/connectors/unity_catalog/README.md.
UC_SERVER_URL=http://localhost:8080/api/2.1/unity-catalog
# UC_TOKEN=bearer-token
UC_CATALOG=unity

# Databricks connectors (managed Unity Catalog). Require the `databricks` extra.
# See neocarta/connectors/databricks/README.md.
#
# Schema connector — reads <catalog>.information_schema.* over a SQL warehouse via
# databricks-sql-connector (in-process DB-API; no Spark/JDBC). PAT auth for v1.
# DATABRICKS_SERVER_HOSTNAME=dbc-xxxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DATABRICKS_CATALOG=main
# DATABRICKS_SCHEMA=default
#
# Governance-tags connector — reads governed-tag definitions via the Databricks
# SDK; no SQL warehouse required.
# DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
#
# Shared: personal access token used by both connectors.
# DATABRICKS_TOKEN=dapi-your-personal-access-token

# Snowflake connectors. Require the `snowflake` extra. See
# neocarta/connectors/snowflake/README.md. Pass identifiers in Snowflake's stored
# case (unquoted objects are upper-cased). The `logs` connector additionally needs
# access to the shared SNOWFLAKE database (IMPORTED PRIVILEGES) for ACCOUNT_USAGE.
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=snowflake-user
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
# SNOWFLAKE_DATABASE=MYDB
# SNOWFLAKE_SCHEMA=PUBLIC
# Choose ONE auth method (precedence: key-pair > authenticator > password).
# Key-pair is required on MFA-enforced accounts, where Snowflake blocks password
# auth for programmatic (driver) access:
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=key-passphrase-if-encrypted
# ...or an authenticator (+ token for oauth / programmatic access tokens):
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_TOKEN=oauth-or-pat-token
# ...or a password (only if your account allows programmatic password auth):
# SNOWFLAKE_PASSWORD=snowflake-password

# Text2SQL agent chat LLM — LiteLLM model id. Examples:
#   gpt-4o-mini
#   gemini-2.0-flash
AGENT_MODEL=gpt-4o-mini

# Embeddings — LiteLLM model id.
# Examples:
#   text-embedding-3-small                       (OpenAI)
#   gemini-embedding-001                         (Vertex AI)
EMBEDDING_MODEL=text-embedding-3-small

# Optional. Vector dimension for models that support truncation (e.g. OpenAI
# text-embedding-3-*). Ignored by models that don't; leave unset to auto-detect.
# EMBEDDING_DIMENSIONS=1536

# Optional. Nodes per embedding batch during CLI ingest runs (default: 100).
# Not used by the MCP server.
# EMBEDDING_BATCH_SIZE=100

# Provider credentials — set the variables your chosen EMBEDDING_MODEL requires.
OPENAI_API_KEY=...
# GEMINI_API_KEY=...
